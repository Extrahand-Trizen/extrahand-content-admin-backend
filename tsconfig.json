{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2019",
    "rootDir": "src",
    "outDir": "dist",

    "allowJs": true,
    "checkJs": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "moduleResolution": "Node",
    "jsx": "preserve"
  },
  "include": ["src/**/*"]
}
